# Copy to .env.local and fill in values from Supabase Dashboard > Project Settings > API.
# Never commit .env.local.

# --- Used by the application (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Development scripts only (scripts/verify-security.ts) ---
# NEVER prefix with NEXT_PUBLIC_. The application code does not read this variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (linking / migrations / type generation) ---
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
